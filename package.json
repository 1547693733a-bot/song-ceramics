{
  "name": "kiln-wheel-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs && node scripts/prune-sites-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:release": "npm run build && node scripts/package-release.mjs",
    "test:release": "playwright test --config playwright.release.config.ts"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.10",
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "gsap": "^3.15.0",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.4.2",
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.3",
    "@vitejs/plugin-react": "6.0.3",
    "meshoptimizer": "1.2.0",
    "typescript": "^5.9.3",
    "vite": "8.1.3"
  }
}
